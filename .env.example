# Data Product Recommendation Engine - runtime configuration.
# Copy to .env (never commit the copy) and export before `dpre serve`.
# Every variable is read by dpre/server/settings.py; docs/deployment.md explains
# which combinations make a supported posture.

# --- where the instance keeps its state ------------------------------------
# The database, the uploads and the upload registry live in $DPRE_WORKSPACE/private
# (0700) and are never served over HTTP.
DPRE_WORKSPACE=/var/lib/dpre
# DPRE_DB=/var/lib/dpre/private/engine.db

# --- where it listens -------------------------------------------------------
# A non-loopback host REFUSES to start without DPRE_TOKENS or DPRE_TRUSTED_PROXY.
DPRE_HOST=127.0.0.1
DPRE_PORT=8000
# Host header allow-list, in addition to the bound address. Comma separated.
# DPRE_ALLOWED_HOSTS=dpre.client.example

# --- who may call it --------------------------------------------------------
# Posture A (development): loopback only. An X-DPRE-Identity header names the
# caller and receives DPRE_DEV_ROLES. This is a convenience, not a control.
# DPRE_DEV_ROLES=reviewer,steward,operator,catalog_admin
#
# Posture B (production): a TLS-terminating SSO proxy authenticates the user and
# forwards the identity. The header is honoured only from these peer addresses.
# DPRE_TRUSTED_PROXY=10.0.0.9
# DPRE_PROXY_IDENTITY_HEADER=X-Forwarded-User
# DPRE_PROXY_ROLES_HEADER=X-Forwarded-Roles
# DPRE_PROXY_DOMAINS_HEADER=X-Forwarded-Groups
#
# Posture C (machine clients): a JSON map {token: {identity, roles, domains}}.
# Store it 0600, outside the workspace, and rotate it like any other secret.
# DPRE_TOKENS=/etc/dpre/tokens.json

# --- limits -----------------------------------------------------------------
DPRE_MAX_UPLOAD_MB=64
# Set to 0/false only behind a proxy that enforces its own CSRF defence.
DPRE_REQUIRE_CSRF_HEADER=true

# --- retention (R-26) -------------------------------------------------------
# Applies to workspace files. Ledger rows are never purged; see docs/security.md.
DPRE_RETENTION_UPLOAD_DAYS=30
DPRE_RETENTION_SEED_DAYS=365
DPRE_RETENTION_RUN_DAYS=365
# Uploaded client extracts are deleted after a successful ingestion by default.
DPRE_KEEP_UPLOADS=false

# --- observability ----------------------------------------------------------
DPRE_LOG_LEVEL=INFO
DPRE_LOG_FORMAT=json

# --- optional model-assisted drafting --------------------------------------
# Unset means template drafting only. Drafts are marked AI_DRAFT either way.
# DPRE_AI_MODEL=
