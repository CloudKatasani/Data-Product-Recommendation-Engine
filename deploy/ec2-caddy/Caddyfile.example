# Reference only: setup.sh writes the real ./Caddyfile for you. See docs/deploy-ec2-caddy.md.
{
	email {$ACME_EMAIL}
}

{$DPRE_DOMAIN} {
	encode gzip

	# Match DPRE_MAX_UPLOAD_MB.
	request_body {
		max_size 64MB
	}

	# Who may sign in. Hash each password with:
	#   docker run --rm caddy:2 caddy hash-password --plaintext 'the-password'
	basic_auth {
		alice $2a$14$REPLACE_WITH_HASH
		bob   $2a$14$REPLACE_WITH_HASH
	}

	# Roles per user: reviewer, steward, operator, catalog_admin, council.
	# Keep council on a different user from anyone who reviews (segregation of duties).
	map {http.auth.user.id} {dpre_roles} {
		alice   "operator,reviewer,steward,catalog_admin"
		bob     "council"
		default "reviewer"
	}

	# Optional domain scope per user; empty means every domain.
	map {http.auth.user.id} {dpre_domains} {
		default ""
	}

	reverse_proxy dpre:8000 {
		# Never pass on what the client asserted; set the identity ourselves.
		header_up -X-DPRE-Identity
		header_up -Authorization
		header_up X-Forwarded-User {http.auth.user.id}
		header_up X-Forwarded-Roles {dpre_roles}
		header_up X-Forwarded-Groups {dpre_domains}
	}
}
